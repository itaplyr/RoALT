{
  "name": "roalt",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/check-i18n.mjs && vite build",
    "i18n:check": "node scripts/check-i18n.mjs",
    "typecheck": "tsc --noEmit",
    "test:sounds": "node --experimental-strip-types scripts/test-sounds.mjs",
    "test:news": "node --experimental-strip-types scripts/test-news.mjs",
    "test:liquid": "node --experimental-strip-types scripts/test-liquid.mjs",
    "tauri": "tauri",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "motion": "14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
